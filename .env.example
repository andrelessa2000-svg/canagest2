# Banco de dados (Neon Postgres)
# 1. Crie um projeto grátis em https://neon.tech e copie as duas strings de conexão.
# 2. Renomeie este arquivo para ".env" e cole os valores abaixo.

# Usada pela aplicação (com -pooler no host, para conexões HTTP/WebSocket).
DATABASE_URL="postgresql://usuario:senha@ep-seu-projeto-pooler.us-east-2.aws.neon.tech/canagest?sslmode=require"

# Usada pelo Prisma CLI (prisma db push / migrate / seed) — conexão direta, sem pooler.
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@ep-seu-projeto.us-east-2.aws.neon.tech/canagest"

# Autenticação (NextAuth)
# 1. Gere un segredo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="genere-un-secreto-largo-aleatorio"
# URL pública do app. Deixe vazio localmente (se infiere del host); na Vercel: https://canagest2.vercel.app
AUTH_URL=""
AUTH_TRUST_HOST=true

# Login com Google (opcional). Cree um projeto OAuth em Google Cloud Console e
# agregue a URL de callback: https://canagest2.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""