generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  criadoEm      DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  passwordResets PasswordResetToken[]
  fazendas     Fazenda[]
  talhoes      Talhao[]
  usinas       Usina[]
  colheitas    Colheita[]
  plantios     Plantio[]
  tratos       Trato[]
  investimentos Investimento[]
  historicoPrecos HistoricoPreco[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  usado     Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Fazenda {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome        String
  ativa       Boolean   @default(true)
  criadaEm    DateTime  @default(now())
  atualizadaEm DateTime @updatedAt
  talhoes     Talhao[]
  colheitas   Colheita[]
  plantios    Plantio[]
  tratos      Trato[]
  investimentos Investimento[]

  @@index([userId, nome])
}

model Talhao {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fazendaId String
  fazenda   Fazenda  @relation(fields: [fazendaId], references: [id], onDelete: Cascade)
  nome      String
  areaHa    Float
  criadoEm  DateTime @default(now())
  plantios  Plantio[]
  tratos    Trato[]
  colheitas Colheita[]

  @@unique([fazendaId, nome])
  @@index([userId])
  @@index([fazendaId])
}

model Usina {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome      String
  modelo    String
  criadaEm  DateTime   @default(now())
  colheitas Colheita[]

  @@unique([userId, nome])
  @@index([userId, nome])
}

model Colheita {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fazendaId       String
  fazenda         Fazenda  @relation(fields: [fazendaId], references: [id], onDelete: Cascade)
  usinaId         String
  usina           Usina    @relation(fields: [usinaId], references: [id], onDelete: Restrict)
  data            DateTime @default(now())
  tipo            String
  safra           String?
  projecao        Boolean  @default(false)
  talhoesColhidos Json?
  toneladas       Float

  // Remuneração — Pindorama
  precoCana Float?
  agio      Float?

  // Remuneração — Coruripe
  atrPorTonelada Float?
  precoKgAtr     Float?

  // Escopo da colheita — mesmo padrão de Plantio e Trato
  talhaoId   String?
  talhao     Talhao? @relation(fields: [talhaoId], references: [id], onDelete: SetNull)
  talhoesIds Json?
  // Porções [{ talhaoId, tarefas, completo }] — mistura de talhões inteiros e partes
  alocacoes  Json?
  escopo     String  @default("fazenda")

  // Área colhida em TAREFAS — base do rateio
  areaColhida Float?

  observacao String?
  criadaEm   DateTime @default(now())

  custo CustoColheita?

  @@index([fazendaId, data])
  @@index([usinaId])
  @@index([data])
  @@index([userId, safra])
  @@index([talhaoId])
}

model CustoColheita {
  id         String   @id @default(cuid())
  colheitaId String   @unique
  colheita   Colheita @relation(fields: [colheitaId], references: [id], onDelete: Cascade)

  // CTC — valor informado pela usina
  ctc Float @default(0)

  // Arrendamento — calculado sobre o preço BRUTO da cana (sem ágio e sem ATR)
  arrendar          Boolean @default(false)
  tonsPorTarefa     Float?
  tarefasArrendadas Float?

  // Dívidas com usina ou terceiros: plantio, operações, semente
  // [{ talhaoId?, nome, quantidade, unidade, valorUnitario, valorTotal }]
  dividas Json?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Plantio {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fazendaId  String
  fazenda    Fazenda  @relation(fields: [fazendaId], references: [id], onDelete: Cascade)
  talhaoId   String?
  talhao     Talhao?  @relation(fields: [talhaoId], references: [id], onDelete: SetNull)
  talhoesIds Json?
  // Porcoes [{ talhaoId, tarefas, completo }] - mistura de talhoes inteiros e partes
  alocacoes  Json?
  // Insumos comuns: [{ talhaoId?, nome, quantidade, unidade, valorUnitario, valorTotal }]
  insumos    Json?
  escopo     String   @default("fazenda")
  tarefas    Float?
  safra      String?
  tipo       String
  data       DateTime @default(now())
  valor      Float
  projecao   Boolean  @default(false)
  areaHa     Float?
  observacao String?
  criadaEm   DateTime @default(now())

  @@index([userId, data])
  @@index([fazendaId, data])
  @@index([talhaoId])
  @@index([userId, safra])
}

model Trato {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fazendaId  String
  fazenda    Fazenda  @relation(fields: [fazendaId], references: [id], onDelete: Cascade)
  talhaoId   String?
  talhao     Talhao?  @relation(fields: [talhaoId], references: [id], onDelete: SetNull)
  talhoesIds Json?
  // Porcoes [{ talhaoId, tarefas, completo }] - mistura de talhoes inteiros e partes
  alocacoes  Json?
  safra      String?
  tipo       String
  escopo     String
  tarefas    Float?
  data       DateTime @default(now())
  valor      Float
  projecao   Boolean  @default(false)
  produtos   Json?
  // Insumos comuns unificados: [{ talhaoId?, nome, quantidade, unidade, valorUnitario, valorTotal }]
  insumos    Json?
  observacao String?
  criadaEm   DateTime @default(now())

  @@index([userId, data])
  @@index([fazendaId, data])
  @@index([talhaoId])
  @@index([userId, safra])
}

model Investimento {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fazendaId  String
  fazenda    Fazenda  @relation(fields: [fazendaId], references: [id], onDelete: Cascade)
  safra      String?
  nome       String
  valor      Float
  data       DateTime @default(now())
  observacao String?
  criadaEm   DateTime @default(now())

  @@index([fazendaId, data])
  @@index([userId, safra])
}

// Preco medio da cana (R$/t) por mes/ano — base do simulador temporal.
// Opcionalmente guarda ATR mensal para usinas que remuneram por kg de ATR
// (Coruripe). Sem ATR, vale o precoMedio (comportamento antigo preservado).
model HistoricoPreco {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ano          Int
  mes          Int // 1-12
  precoMedio   Float? // R$/t do mes — opcional: hoje o comparativo usa o ATR
  atrPorTonelada Float? // kg ATR/t do mes
  precoKgAtr     Float? // R$/kg ATR anunciado pela usina no mes — e o valor que varia
  fonte        String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([userId, ano, mes])
  @@index([userId])
}
