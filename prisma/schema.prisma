generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  criadoEm      DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  passwordResets PasswordResetToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  usado     Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Fazenda {
  id          String    @id @default(cuid())
  nome        String
  criadaEm    DateTime  @default(now())
  atualizadaEm DateTime @updatedAt
  talhoes     Talhao[]
  colheitas   Colheita[]
  plantios    Plantio[]
  tratos      Trato[]
  investimentos Investimento[]

  @@index([nome])
}

model Talhao {
  id        String   @id @default(cuid())
  fazendaId String
  fazenda   Fazenda  @relation(fields: [fazendaId], references: [id], onDelete: Cascade)
  nome      String
  areaHa    Float
  criadoEm  DateTime @default(now())
  plantios  Plantio[]
  tratos    Trato[]

  @@unique([fazendaId, nome])
  @@index([fazendaId])
}

model Usina {
  id        String     @id @default(cuid())
  nome      String     @unique
  modelo    String
  criadaEm  DateTime   @default(now())
  colheitas Colheita[]

  @@index([nome])
}

model Colheita {
  id        String   @id @default(cuid())
  fazendaId String
  fazenda   Fazenda  @relation(fields: [fazendaId], references: [id], onDelete: Cascade)
  usinaId   String
  usina     Usina    @relation(fields: [usinaId], references: [id], onDelete: Restrict)
  data      DateTime @default(now())
  tipo      String
  safra     String?
  projecao  Boolean  @default(false)
  toneladas Float

  // Remuneração — Pindorama
  precoCana Float?
  agio      Float?

  // Remuneração — Coruripe
  atrPorTonelada Float?
  precoKgAtr     Float?

  // CTC (valor informado pela usina)
  ctc Float @default(0)

  // Area colhida (tarefas) — base para arrendamento, adubo e herbicida
  areaColhida Float?

  // Arrendamento (calculado: t/tarefa x preco da cana x tarefas arrendadas)
  arrendar          Boolean @default(false)
  tonsPorTarefa     Float?
  tarefasArrendadas Float?

  // Adubo (calculado: sacos/tarefa x 50 kg x preco da tonelada x area colhida)
  adubo         Boolean @default(false)
  precoTonAdubo Float?
  tarefasAdubo  Float?

  // Herbicida — itens da calda [{ nome, valor }]
  herbicidas Json?

  // Outros insumos — itens dinamicos [{ nome, valor }] (calcario, po de rocha, biologico, vinhaça...)
  insumos Json?

  // Despesas com a usina — itens dinamicos [{ nome, valor }]
  despesasUsina Json?

  observacao String?
  criadaEm   DateTime @default(now())

  @@index([fazendaId, data])
  @@index([usinaId])
  @@index([data])
}

model Plantio {
  id         String   @id @default(cuid())
  fazendaId  String
  fazenda    Fazenda  @relation(fields: [fazendaId], references: [id], onDelete: Cascade)
  talhaoId   String?
  talhao     Talhao?  @relation(fields: [talhaoId], references: [id], onDelete: SetNull)
  talhoesIds Json?
  escopo     String   @default("fazenda")
  tarefas    Float?
  safra      String?
  tipo       String
  data       DateTime @default(now())
  valor      Float
  projecao   Boolean  @default(false)
  areaHa     Float?
  observacao String?
  criadaEm   DateTime @default(now())

  @@index([fazendaId, data])
  @@index([talhaoId])
}

model Trato {
  id         String   @id @default(cuid())
  fazendaId  String
  fazenda    Fazenda  @relation(fields: [fazendaId], references: [id], onDelete: Cascade)
  talhaoId   String?
  talhao     Talhao?  @relation(fields: [talhaoId], references: [id], onDelete: SetNull)
  safra      String?
  tipo       String
  escopo     String
  tarefas    Float?
  data       DateTime @default(now())
  valor      Float
  projecao   Boolean  @default(false)
  produtos   Json?
  observacao String?
  criadaEm   DateTime @default(now())

  @@index([fazendaId, data])
  @@index([talhaoId])
}

model Investimento {
  id         String   @id @default(cuid())
  fazendaId  String
  fazenda    Fazenda  @relation(fields: [fazendaId], references: [id], onDelete: Cascade)
  safra      String?
  nome       String
  valor      Float
  data       DateTime @default(now())
  observacao String?
  criadaEm   DateTime @default(now())

  @@index([fazendaId, data])
}