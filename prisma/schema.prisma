generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Fazenda {
  id          String    @id @default(cuid())
  nome        String
  criadaEm    DateTime  @default(now())
  atualizadaEm DateTime @updatedAt
  talhoes     Talhao[]
  colheitas   Colheita[]

  @@index([nome])
}

model Talhao {
  id        String   @id @default(cuid())
  fazendaId String
  fazenda   Fazenda  @relation(fields: [fazendaId], references: [id], onDelete: Cascade)
  nome      String
  areaHa    Float
  criadoEm  DateTime @default(now())

  @@unique([fazendaId, nome])
  @@index([fazendaId])
}

model Usina {
  id        String     @id @default(cuid())
  nome      String     @unique
  modelo    String
  criadaEm  DateTime   @default(now())
  colheitas Colheita[]

  @@index([nome])
}

model Colheita {
  id        String   @id @default(cuid())
  fazendaId String
  fazenda   Fazenda  @relation(fields: [fazendaId], references: [id], onDelete: Cascade)
  usinaId   String
  usina     Usina    @relation(fields: [usinaId], references: [id], onDelete: Restrict)
  data      DateTime @default(now())
  tipo      String
  toneladas Float

  // Remuneração — Pindorama
  precoCana Float?
  agio      Float?

  // Remuneração — Coruripe
  atrPorTonelada Float?
  precoKgAtr     Float?

  // CTC (valor informado pela usina)
  ctc Float @default(0)

  // Area colhida (tarefas) — base para arrendamento, adubo e herbicida
  areaColhida Float?

  // Arrendamento (calculado: t/tarefa x preco da cana x tarefas arrendadas)
  arrendar          Boolean @default(false)
  tonsPorTarefa     Float?
  tarefasArrendadas Float?

  // Adubo (calculado: sacos/tarefa x 50 kg x preco da tonelada x area colhida)
  adubo         Boolean @default(false)
  precoTonAdubo Float?
  tarefasAdubo  Float?

  // Herbicida — itens da calda [{ nome, valor }]
  herbicidas Json?

  // Outros insumos — itens dinamicos [{ nome, valor }] (calcario, po de rocha, biologico, vinhaça...)
  insumos Json?

  // Despesas com a usina — itens dinamicos [{ nome, valor }]
  despesasUsina Json?

  observacao String?
  criadaEm   DateTime @default(now())

  @@index([fazendaId, data])
  @@index([usinaId])
  @@index([data])
}